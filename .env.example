# Poker Analytics Engine Environment Variables
# Copy this file to .env and replace placeholders with your credentials

# OpenRouter API Key for AI Poker Coach (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model ID (default: claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Backend JWT Authentication Secret (generate a strong random string)
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend Server Port (default: 3001)
PORT=3001
